# =========================
# Mofan / Sass Note - Vercel + Supabase free-stack template
# Never commit real secrets.
# =========================

APP_ENV=production
APP_NAME=Mofan API
APP_VERSION=2.0.0
FRONTEND_ORIGIN=https://YOUR_PROJECT.vercel.app
FRONTEND_ORIGINS=https://YOUR_PROJECT.vercel.app,http://localhost:5173
SESSION_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_DAYS=30
LOG_LEVEL=INFO

# Supabase > Connect > Transaction pooler > URI
DATABASE_URL=postgresql://YOUR_SUPABASE_POOLER_USER:YOUR_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require

# Upstash Redis > Connect > redis-cli / TLS URL
REDIS_URL=rediss://default:YOUR_UPSTASH_PASSWORD@YOUR_UPSTASH_HOST:6379

# Transactional email (Resend SMTP example)
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=re_YOUR_RESEND_API_KEY
DEFAULT_FROM_EMAIL=Mofan <noreply@YOUR_VERIFIED_DOMAIN>
EMAIL_CODE_TTL_SECONDS=600

# Cloudflare R2 (S3-compatible). Browser uploads go directly to R2.
STORAGE_PROVIDER=r2
STORAGE_BUCKET=mofan-files
STORAGE_ENDPOINT_URL=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
STORAGE_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
STORAGE_REGION=auto
STORAGE_PRESIGN_TTL_SECONDS=900

# 2 GiB per object maximum in this application (not a Vercel upload limit; uploads bypass Vercel).
MAX_UPLOAD_BYTES=2147483648

# Every new account receives 20 MiB free attachment storage.
DEFAULT_USER_STORAGE_QUOTA_BYTES=20971520

# Safety guard for zero-cost operation. R2's current free storage allowance is 10 GB-month.
# Keep this below 10 billion bytes to leave headroom for the free storage tier. This guard does not cover operation/request charges.
# Set 0 only if you accept provider charges above the free tier.
FREE_STORAGE_GLOBAL_CAP_BYTES=9000000000

# Optional payments. Free mode works with PAYMENTS_ENABLED=false.
# Stripe Standard has no setup/monthly fee, but successful payments still incur transaction fees.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=sk_test_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_SECRET
STRIPE_PRO_PRICE_ID=price_YOUR_PRO_PRICE
STRIPE_TEAM_PRICE_ID=price_YOUR_TEAM_PRICE
BILLING_SUCCESS_URL=https://YOUR_PROJECT.vercel.app/app?billing=success
BILLING_CANCEL_URL=https://YOUR_PROJECT.vercel.app/app?billing=cancel

# Site administrators (comma-separated login emails). Only these accounts can manage storage expansion.
SITE_ADMIN_EMAILS=admin@example.com
# Manual/offline payment instructions shown after an admin quotes a storage expansion.
STORAGE_PAYMENT_INSTRUCTIONS=请联系管理员完成扩容付款，付款后回到扩容页面点击“我已付款”。
